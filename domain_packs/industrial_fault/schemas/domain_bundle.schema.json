  "$id": "https://pump-copilot.local/schemas/industrial-fault/domain_bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A self-contained, reviewable snapshot of one domain workspace.",
  "properties": {
    "bundle_version": {
      "minLength": 1,
      "title": "Bundle Version",
      "type": "string"
    },
    "entities": {
      "items": {
        "discriminator": {
          "mapping": {
            "Department": "#/$defs/Department",
            "Equipment": "#/$defs/Equipment",
            "FaultEvent": "#/$defs/FaultEvent",
            "File": "#/$defs/FileAsset"
          },
          "propertyName": "class_code"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/Department"
          },
          {
            "$ref": "#/$defs/FileAsset"
          },
          {
            "$ref": "#/$defs/Equipment"
          },
          {
            "$ref": "#/$defs/FaultEvent"
          }
        ]
      },
      "minItems": 1,
      "title": "Entities",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    },
    "ontology_version": {
      "minLength": 1,
      "title": "Ontology Version",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/FaultCauseRule"
      },
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "trace": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionTrace"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tree": {
      "anyOf": [
        {
          "$ref": "#/$defs/FaultTreeDraft"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "bundle_version",
    "ontology_version",
    "schema_version",
    "tenant_id",
    "entities"
  ],
  "title": "DomainBundle",
  "type": "object",
  "x-ontology-version": "industrial-fault-v0.1",
  "x-schema-version": "industrial-fault-schema-v0.1"
