# Copy to nexent/.env and edit before running the import or demo scripts.
#
# The import and demo entry points automatically load this file from
# `nexent/.env` when it exists. Variables already exported in the process win.
# For manual shell use in Git Bash:
#
#     set -a; source nexent/.env; set +a
#
# In PowerShell:
#
#     Get-Content nexent/.env | ForEach-Object { ... }   # or set each variable
#
# Keep nexent/.env out of git (it is already covered by the root .gitignore
# rule for .env files).

# --- Nexent endpoints -------------------------------------------------------
# Management/config API, port 5010 of the Nexent deployment.
NEXENT_CONFIG_URL=http://localhost:5010
# Northbound API, port 5013. Used by the demo only.
NEXENT_NORTHBOUND_URL=http://localhost:5013

# --- Nexent account ---------------------------------------------------------
# The super admin created on first deploy. If you set
# NEXENT_SUPER_ADMIN_PASSWORD before deploying, use that password here.
NEXENT_EMAIL=suadmin@nexent.com
NEXENT_PASSWORD=Nexent@123

# --- MCP server -------------------------------------------------------------
# URL as seen FROM THE NEXENT CONTAINERS. Docker Desktop resolves
# host.docker.internal to the Windows host, where the MCP server listens.
# On a Linux Docker engine use the host gateway address instead, or run the
# MCP server in the same compose network.
# For a Nexent instance on another machine, use that machine's reachable
# address (the MCP server must listen on 0.0.0.0).
NEXENT_MCP_URL=http://host.docker.internal:8765/mcp
NEXENT_GOVERNANCE_MCP_URL=http://host.docker.internal:8766/mcp

# --- MCP server process (read by mcp_server, not by nexent/scripts) ---------
# Keep these consistent with the storage directory the import script seeds.
MCP_HOST=0.0.0.0
MCP_PORT=8765
MCP_DOMAIN_STORAGE_DIR=domain_packs/industrial_fault/storage
# Must match "name" in nexent/config/mcp.json so the tool catalog's usage
# column and the registered server name agree.
MCP_SERVER_NAME=industrial-fault-domain
# MCP_LOG_LEVEL=INFO

# --- Ontology governance MCP ------------------------------------------------
# Read by governance_mcp_server. The root stores immutable ontology versions,
# change sets and review events; it is separate from tenant domain snapshots.
ONTOLOGY_GOVERNANCE_HOST=0.0.0.0
ONTOLOGY_GOVERNANCE_PORT=8766
ONTOLOGY_GOVERNANCE_ROOT=domain_packs/industrial_fault/storage/governance
ONTOLOGY_GOVERNANCE_SOURCE=domain_packs/industrial_fault/ontology.yml
ONTOLOGY_GOVERNANCE_DOMAIN_STORAGE=domain_packs/industrial_fault/storage
ONTOLOGY_GOVERNANCE_SERVER_NAME=ontology-governance
# ONTOLOGY_GOVERNANCE_LOG_LEVEL=INFO
