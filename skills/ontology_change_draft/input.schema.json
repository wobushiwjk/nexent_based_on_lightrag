{
  "$defs": {
    "AddClassChange": {
      "additionalProperties": false,
      "description": "Propose a new ontology class.",
      "properties": {
        "change_type": {
          "const": "add_class",
          "title": "Change Type",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "prompt_visible": {
          "default": true,
          "title": "Prompt Visible",
          "type": "boolean"
        },
        "required_fields": {
          "items": {
            "type": "string"
          },
          "title": "Required Fields",
          "type": "array"
        },
        "standards": {
          "items": {
            "type": "string"
          },
          "title": "Standards",
          "type": "array"
        }
      },
      "required": [
        "change_type",
        "code",
        "label"
      ],
      "title": "AddClassChange",
      "type": "object"
    },
    "AddConstraintChange": {
      "additionalProperties": false,
      "description": "Propose a new ontology constraint.",
      "properties": {
        "applies_to": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Applies To",
          "type": "array"
        },
        "change_type": {
          "const": "add_constraint",
          "title": "Change Type",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "rule": {
          "minLength": 1,
          "title": "Rule",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "change_type",
        "id",
        "applies_to",
        "rule"
      ],
      "title": "AddConstraintChange",
      "type": "object"
    },
    "AddRelationChange": {
      "additionalProperties": false,
      "description": "Propose a new ontology relation.",
      "properties": {
        "change_type": {
          "const": "add_relation",
          "title": "Change Type",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "directed": {
          "default": true,
          "title": "Directed",
          "type": "boolean"
        },
        "evidence_required": {
          "default": true,
          "title": "Evidence Required",
          "type": "boolean"
        },
        "source_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Types",
          "type": "array"
        },
        "target_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Types",
          "type": "array"
        }
      },
      "required": [
        "change_type",
        "code",
        "source_types",
        "target_types"
      ],
      "title": "AddRelationChange",
      "type": "object"
    },
    "DeprecateClassChange": {
      "additionalProperties": false,
      "description": "Propose deprecating an existing ontology class.",
      "properties": {
        "change_type": {
          "const": "deprecate_class",
          "title": "Change Type",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "replacement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement"
        }
      },
      "required": [
        "change_type",
        "code"
      ],
      "title": "DeprecateClassChange",
      "type": "object"
    },
    "SourceTarget": {
      "additionalProperties": false,
      "description": "A domain record that motivates the change.",
      "properties": {
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "target_type": {
          "enum": [
            "entity",
            "fact",
            "rule",
            "logic_gate",
            "decision_step"
          ],
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "target_type",
        "target_id"
      ],
      "title": "SourceTarget",
      "type": "object"
    }
  },
  "$id": "https://pump-copilot.local/skills/ontology_change_draft/input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Input contract for the ontology-change-draft skill.",
  "properties": {
    "change": {
      "discriminator": {
        "mapping": {
          "add_class": "#/$defs/AddClassChange",
          "add_constraint": "#/$defs/AddConstraintChange",
          "add_relation": "#/$defs/AddRelationChange",
          "deprecate_class": "#/$defs/DeprecateClassChange"
        },
        "propertyName": "change_type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AddClassChange"
        },
        {
          "$ref": "#/$defs/AddRelationChange"
        },
        {
          "$ref": "#/$defs/AddConstraintChange"
        },
        {
          "$ref": "#/$defs/DeprecateClassChange"
        }
      ],
      "title": "Change"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "source_targets": {
      "items": {
        "$ref": "#/$defs/SourceTarget"
      },
      "title": "Source Targets",
      "type": "array"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "change",
    "rationale"
  ],
  "title": "OntologyChangeRequest",
  "type": "object",
  "x-skill-name": "ontology_change_draft",
  "x-skill-version": "0.1.0"
}
