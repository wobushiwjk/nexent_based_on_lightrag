# Copy to training/.env and fill in locally.  training/.env is git-ignored.
#
# The teacher must expose an OpenAI-compatible /v1/chat/completions endpoint.
# Only sources marked `public: true` in training/corpus/sources.yml may be sent.
W7_TEACHER_ENDPOINT=https://api.deepseek.com/v1
W7_TEACHER_MODEL=deepseek-flash
W7_TEACHER_API_KEY=
W7_TEACHER_TIMEOUT=120
W7_TEACHER_MAX_CONCURRENCY=2
W7_TEACHER_MAX_ATTEMPTS=3
# Some gateways reject response_format; set to false if you get HTTP 400.
W7_TEACHER_JSON_MODE=true

# Optional cost/scale guards for the teacher-labeling CLI.
W7_TEACHER_MAX_CHUNKS=0
W7_TEACHER_MAX_OUTPUT_TOKENS=2048

# Runtime student endpoint used by the Nexent upload ingestion MCP.
# The value must point at this local model, not at the external teacher.
W7_STUDENT_ENDPOINT=http://127.0.0.1:8000/v1
W7_STUDENT_MODEL=industrial-extractor
W7_STUDENT_API_KEY=
W7_STUDENT_TIMEOUT=120
W7_STUDENT_MAX_OUTPUT_TOKENS=1536
W7_STUDENT_MAX_ATTEMPTS=2
